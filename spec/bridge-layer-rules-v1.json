{
  "schemaVersion": 1,
  "kbt": {
    "required": false,
    "downloadedPackageValidated": true,
    "installed": false,
    "autoLayerEnabled": false
  },
  "codexIntegration": {
    "catalogPrimary": "official-codex-app-server-thread-list-over-stdio-jsonl",
    "catalogFallback": "read-only-local-state-database-with-30-second-retry",
